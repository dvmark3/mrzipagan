<section id="contact" class="mx-auto max-w-xl px-6 py-16">
    <h2 class="text-2xl font-bold">Contact</h2>
    <form action="#" class="mt-6 flex flex-col gap-4">
        <label for="name" class="font-medium">Name</label>
        <input
            type="text"
            id="name"
            name="name"
            required
            class="rounded-lg border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800"
        />

        <label for="email" class="font-medium">Email</label>
        <input
            type="email"
            id="email"
            name="email"
            required
            class="rounded-lg border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800"
        />

        <label for="message" class="font-medium">Message</label>
        <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="rounded-lg border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800"
        ></textarea>

        <button type="submit" class="btn-primary self-start"
            >Send Message</button
        >
    </form>
</section>
